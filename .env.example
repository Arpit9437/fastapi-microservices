# Database Configuration
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5434/microservices_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO

# Service URLs (for inter-service communication)
USER_SERVICE_URL=http://user-service:8000
ORDER_SERVICE_URL=http://order-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000

# Payment Provider (for production)
PAYMENT_PROVIDER_URL=https://api.stripe.com
PAYMENT_PROVIDER_KEY=sk_test_your_stripe_key_here
